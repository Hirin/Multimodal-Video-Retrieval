# === API keys and LLM configuration ===
# NOTE: Do NOT commit this file with real secrets. Consider adding .env to .gitignore.
# Provider selector: openai | gemini | anthropic | cohere (use one of these)
LLM_PROVIDER=openai

# OpenAI (default in UI)
OPENAI_API_KEY=
# Optional: custom base URL (leave empty to use https://api.openai.com/v1)
OPENAI_BASE_URL=
# Default model used by the app (can be overridden in UI)
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=AIzaSyClRLOcvE6WECyHMR7_9z6rf-W0RT0fzAQ
GEMINI_MODEL=gemini-1.5-pro

# (Optional) Other providers
ANTHROPIC_API_KEY=
COHERE_API_KEY=

# === Optional app configuration ===
# If your data root differs, set it here (the app also allows overriding in UI)
DATA_ROOT=/mnt/shared/HCMC-AI
# Streamlit port (optional)
STREAMLIT_SERVER_PORT=8501

